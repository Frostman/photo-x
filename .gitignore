# Xcode
DerivedData/
build/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Generated by XcodeGen from project.yml — do not commit
PhotoX.xcodeproj/
/PhotoX/Info.plist

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved

# swiftly project toolchain pin — `just linux-build` is explicit
# about the toolchain via `swiftly run`, and Xcode uses its own
# toolchain. Committing this would force swiftly on devs who only
# build the macOS app.
.swift-version

# Cross-compiled binary staged for the Docker smoke test (rebuilt
# every `just linux-test` run from build/photox-arm64).
Indexer/Tests/Docker/photox-arm64

# Misc
.DS_Store
*.swp
*.swo
*~

# Claude Code local agent settings
.claude/

# Sample shoot data (kept locally, never committed)
sample/
sample*/

# Bootstrap-materialised vendored deps (regenerate via scripts/bootstrap.sh)
/ThirdParty/
/Resources/exiftool/

# Release artefacts
*.xcarchive
/build/

# Local release config (Developer ID identity + notarytool keychain
# profile). Copy from scripts/release.local.env.example.
scripts/release.local.env

# Logs and crash reports
*.log
*.crash
