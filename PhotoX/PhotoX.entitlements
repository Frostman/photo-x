<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Release entitlements. Empty by design: we sign with Developer
       ID + hardened runtime, and Sparkle.framework is re-signed
       inside-out with the same identity in release.sh — no
       library-validation exception needed.
       Debug builds use PhotoX-Debug.entitlements (which DOES grant
       the exception, because dev is ad-hoc-signed). -->
</dict>
</plist>
