<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Debug builds are ad-hoc-signed and so is the bundled
       Sparkle.framework; both report "no Team ID" which the hardened
       runtime treats as mismatched. This exception lets the dev build
       load Sparkle. Release builds (PhotoX.entitlements) DON'T need
       it because we Developer-ID-sign Sparkle alongside the app with
       the same identity. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
