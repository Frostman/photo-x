# Copy to scripts/release.local.env (gitignored) and fill in.
# Used by scripts/release.sh to drive Developer ID signing + notarization.
DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"
NOTARYTOOL_KEYCHAIN_PROFILE="PhotoX-Notarize"

# PostHog Cloud ingest-only key (phc_...). Optional — leave empty
# to disable telemetry uploads entirely. Read by the Justfile's
# _posthog_key helper for `just dev` / `just build` AND forwarded
# by release.sh for archive + verify-only xcodebuild calls.
POSTHOG_API_KEY=""
