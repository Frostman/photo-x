<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Debug helper is ad-hoc-signed. Same library-validation
       exception as the main Debug app uses (see
       PhotoX/PhotoX-Debug.entitlements) so the hardened runtime
       doesn't reject the unsigned-by-team helper at launch. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
